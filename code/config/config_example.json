{
  "_note": "Example config — DO NOT store real hosts, credentials, or API keys here. Use env vars or runtime config.",
  "experiment_name": "Mem0-Oracle_Llama3.3",
  "process_context_only": false,

  "dataset_config": {
    "dataset_type": "longmemeval",
    "dataset_path": "./data/longmemeval/longmemeval_oracle.json",
    "max_questions": null,
    "filters": {}
  },

  "llm_config": {
    "backend_type": "ollama",
    "host": "http://OLLAMA_HOST:11434",
    "model": "llama3.3:latest",
    "temperature": 0.7,
    "top_p": 0.9,
    "_comment": "Set OLLAMA_HOST via environment variable or runtime config"
  },

  "memory_system_config": {
    "system_type": "mem0_local",
    "version": "v1.1",
    "search_threshold": 0.0,
    "search_limit": 10,
    "user_id": "USER_ID_PLACEHOLDER",
    "llm": {
      "provider": "ollama",
      "config": {
        "model": "llama3.3:latest",
        "ollama_base_url": "http://OLLAMA_HOST:11434",
        "temperature": 0,
        "max_tokens": 2000
      }
    },
    "embedder": {
      "provider": "ollama",
      "config": {
        "model": "nomic-embed-text:latest",
        "ollama_base_url": "http://OLLAMA_HOST:11434"
      }
    },
    "vector_store": {
      "provider": "qdrant",
      "config": {
        "host": "QDRANT_HOST",
        "port": 6333,
        "collection_name": "memories_S",
        "embedding_model_dims": 768
      }
    }
  },

  "evaluation_config": {
    "evaluator_types": ["llm_judge", "reference_accuracy", "latency", "memory_token_usage"],
    "judge_backend_type": "ollama",
    "judge_host": "http://OLLAMA_HOST:11434",
    "judge_model": "llama3.3:latest",
    "judge_temperature": 0.0,
    "max_tokens": 10
  },

  "output_config": {
    "output_dir": "./outputs/mem0_oracle_llama3.3"
  }
}
