{
  "experiment_name": "full_context_baseline",
  "dataset_config": {
    "dataset_type": "longmemeval"
  },
  "memory_system_config": {
    "system_type": "full_context",
    "include_session_separators": true
  },
  "llm_config": {
    "backend_type": "ollama",
    "host": "http://localhost:11434",
    "model": "llama3.3:latest",
    "temperature": 0.1,
    "top_p": 0.9,
    "_comment": "Replace localhost with your Ollama server address"
  },
  "evaluation_config": {
    "evaluator_type": "llm_judge",
    "judge_backend_type": "ollama",
    "judge_host": "http://localhost:11434",
    "judge_model": "llama3.3:latest",
    "judge_temperature": 0.0,
    "max_tokens": 10,
    "_comment": "Replace localhost with your Ollama server address"
  },
  "output_config": {
    "output_dir": "outputs/json_test",
    "save_predictions": true,
    "save_evaluations": true
  },
  "max_questions": 5,
  "batch_size": 1,
  "save_intermediate": true,
  "seed": 42
}
